# FinDoc Intelligence SaaS Platform Environment Config
DEBUG=True
DJANGO_SECRET_KEY=production-secure-fintech-key-replace-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*.vercel.app

# Database (PostgreSQL URL or leaves empty for auto SQLite)
DATABASE_URL=postgres://findoc:findocpass@localhost:5432/findoc_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=True

# AI & OpenAI LLM Engine (Optional - will use robust NLP heuristic fallback if omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Stripe SaaS Billing (Optional / Mock mode enabled by default)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook
